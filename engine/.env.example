# =============================================================================
# roadscore-engine — environment
# =============================================================================
#
# Copy to `.env` and fill in. Loaded by Node 22's built-in `process.loadEnvFile`
# (no dotenv dependency); in a container the orchestrator supplies these
# directly and no .env file needs to exist.
#
# Validated by src/config/env.ts at startup. A missing or malformed value stops
# the process with every problem listed at once — the engine never boots into a
# half-configured state where the failure only surfaces on the first write.
#
# NOTHING IN THIS FILE IS A REAL SECRET. Do not commit a filled-in .env.
# =============================================================================


# --- Supabase ----------------------------------------------------------------

# Project URL. Used only by the supabase-js Realtime client — the engine's
# writes do not go through PostgREST (see ENGINE-PLAN §3).
SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API -> service_role.
#
# This key bypasses RLS entirely, which is exactly why the engine uses it: it is
# the only writer to the tables in 002_engine.sql, and no client is ever granted
# insert/update/delete there. It is a full-database credential. It must never be
# bundled into a dashboard, pasted into a client, or logged.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...replace-me

# Direct Postgres connection, for the write path and the sweeper's scans.
# Project Settings -> Database -> Connection string.
#
# Prefer the *session* pooler (port 5432) or a direct connection. The
# transaction pooler on port 6543 does not support prepared statements or
# session-scoped advisory locks, and the sweeper's single-instance guard
# (withAdvisoryLock, ENGINE-PLAN §9) depends on session-scoped locks — with a
# transaction pooler two replicas would both believe they hold it.
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres


# --- Process -----------------------------------------------------------------

# Fastify: /healthz /readyz /metrics /admin/replay
PORT=8080

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# development | test | production
NODE_ENV=development


# --- Sweeper (ENGINE-PLAN §3) ------------------------------------------------
#
# Realtime buys latency; the sweeper buys completeness. `postgres_changes` drops
# messages on reconnect, on channel error and under load, so this loop is the
# correctness guarantee rather than a fallback.

# How often to poll for rows Realtime may have missed.
SWEEPER_INTERVAL_MS=5000

# How far back to re-scan on every sweep.
#
# `telemetry.server_received_at` defaults to now() = transaction START time, so
# rows commit out of order relative to it. A strict `>` watermark therefore
# permanently skips any row whose transaction started before the cursor and
# committed after it. Re-reading this overlap and de-duplicating on `id` closes
# that hole. Should comfortably exceed the longest insert transaction.
# Setting this to 0 is not allowed; it would reintroduce the bug.
SWEEPER_OVERLAP_S=10

# Rows fetched per sweep. Bounds one batch's memory; the loop simply runs again
# if it filled the limit, so this is a throughput knob, not a ceiling.
SWEEPER_BATCH=5000


# --- Writer (ENGINE-PLAN §5) -------------------------------------------------
#
# Detection is single-digit microseconds per row; the DB write path is the
# bottleneck. The sink batches until whichever of these two fires first.

# Max time a finished event waits before being written. Directly bounds the
# engine's contribution to the p95 telemetry-row -> event-row target of 500 ms.
WRITER_FLUSH_MS=250

# Max rows per multi-row INSERT.
WRITER_MAX_ROWS=500


# --- Feature flags -----------------------------------------------------------
#
# Independently switchable so each ingest path can be observed in isolation.
#   ENABLE_REALTIME=false -> pure sweeper: higher latency, provably complete.
#                            The right setting for a historical backfill run.
#   ENABLE_SWEEPER=false  -> isolates Realtime so its drop rate can actually be
#                            measured instead of being quietly repaired by the
#                            backfill. Do not run this way in production.
ENABLE_REALTIME=true
ENABLE_SWEEPER=true


# --- State (ENGINE-PLAN §9) --------------------------------------------------

# Evict a device's in-memory state after this long with no rows. Each device
# holds ~11.5 KB of preallocated typed arrays; without eviction a fleet that
# churns device ids grows the state map without bound. Keep this well above the
# trip-abandon timeout (THRESHOLDS.trip.staleAbandonS) or a device could be
# evicted mid-trip and leave an orphaned open trip.
DEVICE_STATE_TTL_MS=1800000
