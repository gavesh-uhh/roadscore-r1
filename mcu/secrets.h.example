#pragma once

// ---------------------------------------------------------------------------
// Secrets template — copy this file to `secrets.h`, fill in your values, and
// keep `secrets.h` out of git (it is already listed in .gitignore).
//
//   cp secrets.h.example secrets.h
//
// Do NOT commit real credentials to source control.
// ---------------------------------------------------------------------------

// WiFi
#define WIFI_SSID      "your-wifi-ssid"
#define WIFI_PASSWORD  "your-wifi-password"

// Supabase — REST endpoint of the telemetry table + an API key.
//   URL:  https://<project-ref>.supabase.co/rest/v1/telemetry
//   KEY:  anon key (with an RLS insert policy) is preferred for a real device.
//         Never ship a service_role key in firmware you don't physically control.
#define SUPABASE_URL   "https://YOUR_PROJECT_REF.supabase.co/rest/v1/telemetry"
#define SUPABASE_KEY   "YOUR_SUPABASE_ANON_KEY"

// Stable identity for this unit — one per physical device.
#define DEVICE_ID      "ROADSCORE_001"

// Optional: Root CA Certificate for secure TLS (e.g., ISRG Root X1 for Let's Encrypt / Supabase)
// If you want strict TLS verification, define it here:
// #define SUPABASE_CA_CERT \
// "-----BEGIN CERTIFICATE-----\n" \
// "...\n" \
// "-----END CERTIFICATE-----\n"
