{
  "name": "roadscore-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "RoadScore (R1) - Edge Telematics, Road Quality Mapping & Transparent Driver Safety Scoring",
  "type": "module",
  "workspaces": [
    "engine",
    "web",
    "sim"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:sim": "node scripts/dev.js --sim",
    "dev:worst": "node scripts/dev.js --sim-worst",
    "dev:penalties": "node scripts/dev.js --sim-penalties",
    "sim": "tsx sim/src/index.ts",
    "sim:tui": "tsx sim/src/index.ts",
    "build": "npm run build --workspace=engine && npm run build --workspace=web && npm run build --workspace=sim",
    "start": "node scripts/start.js",
    "test": "npm test --workspace=engine && npm test --workspace=sim",
    "typecheck": "npm run typecheck --workspace=engine && npm run typecheck --workspace=sim",
    "sim:live": "npm run sim:live --workspace=engine",
    "sim:worst": "npm run sim:worst --workspace=engine",
    "sim:live:worst": "npm run sim:live:worst --workspace=engine",
    "deploy:vps": "bash scripts/vps-deploy.sh",
    "run_engine": "bash run_engine.sh"
  },
  "keywords": [
    "telematics",
    "iot",
    "esp32",
    "nextjs",
    "driver-scoring",
    "road-quality",
    "pothole-detection"
  ],
  "author": "RoadScore Team",
  "license": "MIT"
}
